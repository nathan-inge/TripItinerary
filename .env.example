# Tripit configuration. Copy to ~/.config/tripit/env on the host (mode 0600).
# Local dev: source this from your shell, or set DEV_BYPASS_AUTH=1 and skip
# the Cloudflare Access vars.

# --- Required in production ---

# Cloudflare Access team domain (no scheme).
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com

# Application Audience (AUD) tag from the CF Access application config.
CF_ACCESS_AUD=

# Owner allow-list — required. Comma-separated list of emails; each must match
# the `email` claim in a CF Access JWT to be granted access. No default: the
# app fails to start if this is unset.
OWNER_EMAIL=you@example.com
# OWNER_EMAIL=you@example.com,partner@example.com

# --- Parsing backend ---
# Pick one. If unset, defaults to ollama (if TRIPIT_OLLAMA_URL is explicitly
# set), else anthropic (if ANTHROPIC_API_KEY is set), else none.
# TRIPIT_PARSE_BACKEND=ollama   # anthropic | ollama | none | dry-run

# Option A: cloud (Anthropic). Confirmation text leaves the host (PII-redacted).
# ANTHROPIC_API_KEY=sk-ant-...
# TRIPIT_PARSE_MODEL=claude-sonnet-4-6

# Option B: local (Ollama). Confirmation text never leaves the host. Recommended
# for privacy. Install via `curl -fsSL https://ollama.com/install.sh | sh` on
# the host, then `ollama pull qwen2.5:7b-instruct`.
# TRIPIT_OLLAMA_URL=http://localhost:11434
# TRIPIT_OLLAMA_MODEL=qwen2.5:7b-instruct

# Option C: dry-run. No LLM call. The redactor still runs, and the raw input,
# the post-redaction body, the conf-substitution map, and per-category counts
# are all logged to journalctl. Useful for verifying that what would be sent
# to the LLM doesn't contain anything sensitive — without spending tokens or
# letting bytes off the host. Paste paths return a 400 pointing at the logs;
# the email intake path silently no-ops after logging. Never use in prod.
# TRIPIT_PARSE_BACKEND=dry-run

# Hard ceiling on tokens spent per UTC day. Applies to both backends; harmless
# for Ollama (no $ cost) but still tracks accidental loops.
# TRIPIT_DAILY_TOKEN_CAP=200000

# --- Other optional overrides ---

# Where the SQLite database lives.
# DATABASE_URL=sqlite:///home/USER/.tripit/db.sqlite?mode=rwc

# What the backend binds to. Use 0.0.0.0 only behind a tunnel.
# BIND_ADDR=127.0.0.1:5050

# Shared secret with the Cloudflare Email Worker. HMAC over the POST body.
# Generate with: openssl rand -hex 32
# Required if email intake (DEPLOY.md §7) is set up.
# TRIPIT_EMAIL_HMAC_KEY=

# The intake address shown in the UI is a frontend build-time var, not a
# backend one: set VITE_INTAKE_ADDRESS in frontend/.env.local. See DEPLOY.md §7.

# Logging filter, see `tracing_subscriber::EnvFilter`.
# RUST_LOG=tripit=info,tower_http=info

# --- Local dev escape hatch ---
# Set this to 1 to skip CF Access JWT verification entirely. NEVER set in prod.
# DEV_BYPASS_AUTH=1
